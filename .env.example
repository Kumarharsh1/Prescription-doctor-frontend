# ============================================================
# AI Prescription Intelligence - Frontend Environment Variables
# ============================================================
# Copy this file to .env for local development, or set in your
# Render "Static Site" environment settings.
#
# IMPORTANT: In production (Render), create a .env file with the
# real backend URL when building. Vite bakes this in at build time.

# URL of the deployed backend API (no trailing slash).
# Example: https://prescription-doctor-backend.onrender.com
VITE_API_URL=/api
